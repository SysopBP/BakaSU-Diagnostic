From d627b43fdebbeb4cbe412b6c0d5c837721fa941e Mon Sep 17 00:00:00 2001
From: LoveSy <shana@zju.edu.cn>
Date: Thu, 8 Oct 2026 23:10:58 +0900
Subject: [PATCH 08/12] kernel: pkg_observer: defer track_throne to task_work
 (https://github.com/tiann/KernelSU/pull/3871)

The fsnotify handler called track_throne() inline, while the task that
created or renamed packages.list still held the /data/system dir lock
and fsnotify_mark_srcu. The whole scan (packages.list parse, /data/app
walk, APK signature check) ran under them, stalling other /data/system
dir ops and fsnotify mark teardown, and could ABBA-deadlock on
throne_tracker_mutex against other track_throne() callers, whose
packages.list lookup may take the dir lock under it.

Queue it as TWA_RESUME task_work on that task instead. It still runs
before the syscall returns, but with no locks held and in the task's own
namespaces; a kworker would use init_task's, which differ on
WSA/Waydroid. Skip it if the task is exiting, as task_work then runs
after exit_fs(). Fall back to the inline call for kthreads or if
queueing fails.

Co-authored-by: eltavine <me@eltavine.com>
Co-authored-by: FldBudin <103419694+FldBudin@users.noreply.github.com>

[cherry-picked from upstream commit https://github.com/tiann/KernelSU/commit/ab23091edfeddc774e1e880b0919b211808a193e]

Signed-off-by: AlexLiuDev233 <wzylin11@outlook.com>
---
 kernel/manager/pkg_observer.c | 35 ++++++++++++++++++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/kernel/manager/pkg_observer.c b/kernel/manager/pkg_observer.c
index 740887b4..cab74ce5 100644
--- a/kernel/manager/pkg_observer.c
+++ b/kernel/manager/pkg_observer.c
@@ -3,8 +3,10 @@
 #include <linux/fs.h>
 #include <linux/namei.h>
 #include <linux/fsnotify_backend.h>
+#include <linux/sched.h>
 #include <linux/slab.h>
 #include <linux/rculist.h>
+#include <linux/task_work.h>
 #include <linux/version.h>
 #include "klog.h" // IWYU pragma: keep
 #include "manager/throne_tracker.h"
@@ -21,6 +23,37 @@ struct watch_dir {
 
 static struct fsnotify_group *g;
 
+static void ksu_track_throne_tw_func(struct callback_head *cb)
+{
+    kfree(cb);
+    // Runs after exit_fs() if the task is exiting; path lookups would oops
+    if (current->flags & PF_EXITING)
+        return;
+    track_throne(TRACK_THRONE_FORCE_SYNCHRONOUS);
+}
+
+// Never scan from the fsnotify handler: fsnotify_mark_srcu and the rename's dir
+// locks would be held for the whole scan. Defer with task_work, not a kthread
+// or kworker: the scan must finish before the rename returns, or the manager
+// can be opened before it is crowned, and it must run in the renamer's
+// (Android's) namespaces, which differ from init_task's on WSA/Waydroid.
+static void ksu_defer_track_throne(void)
+{
+    struct callback_head *cb;
+
+    if (!(current->flags & PF_KTHREAD)) {
+        cb = kzalloc(sizeof(*cb), GFP_KERNEL);
+        if (cb) {
+            cb->func = ksu_track_throne_tw_func;
+            if (!task_work_add(current, cb, TWA_RESUME))
+                return;
+            kfree(cb);
+        }
+    }
+    pr_warn("defer track_throne failed, run it inline\n");
+    track_throne(TRACK_THRONE_FORCE_SYNCHRONOUS);
+}
+
 static int ksu_handle_inode_event(struct fsnotify_mark *mark, u32 mask, struct inode *inode, struct inode *dir,
                                   const struct qstr *file_name, u32 cookie)
 {
@@ -30,7 +63,7 @@ static int ksu_handle_inode_event(struct fsnotify_mark *mark, u32 mask, struct i
         return 0;
     if (file_name->len == 13 && !memcmp(file_name->name, "packages.list", 13)) {
         pr_info("packages.list detected: %d\n", mask);
-        track_throne(TRACK_THRONE_FORCE_SYNCHRONOUS);
+        ksu_defer_track_throne();
     }
     return 0;
 }
