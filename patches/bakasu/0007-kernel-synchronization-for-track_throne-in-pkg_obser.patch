From 8a3a13434bbe4a90e0af1069770e921ae51449c4 Mon Sep 17 00:00:00 2001
From: AlexLiuDev233 <wzylin11@outlook.com>
Date: Sat, 26 Sep 2026 18:56:47 +0800
Subject: [PATCH 07/12] kernel: synchronization for track_throne in
 pkg_observer

We can't async for this, or user may see Not Installed display in manager...

Signed-off-by: AlexLiuDev233 <wzylin11@outlook.com>
---
 kernel/manager/pkg_observer.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/kernel/manager/pkg_observer.c b/kernel/manager/pkg_observer.c
index 01206f15..740887b4 100644
--- a/kernel/manager/pkg_observer.c
+++ b/kernel/manager/pkg_observer.c
@@ -30,7 +30,7 @@ static int ksu_handle_inode_event(struct fsnotify_mark *mark, u32 mask, struct i
         return 0;
     if (file_name->len == 13 && !memcmp(file_name->name, "packages.list", 13)) {
         pr_info("packages.list detected: %d\n", mask);
-        track_throne(0);
+        track_throne(TRACK_THRONE_FORCE_SYNCHRONOUS);
     }
     return 0;
 }
@@ -121,4 +121,4 @@ void __exit ksu_observer_exit(void)
     unwatch_one_dir(&g_watch);
     fsnotify_put_group(g);
     pr_info("%s: done.\n", __func__);
-}
\ No newline at end of file
+}
